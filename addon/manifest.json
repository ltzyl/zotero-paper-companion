  "author": "Paper Companion contributors",
  "applications": {
    "zotero": {
      "id": "paper-companion@ltzyl.github.io",
      "update_url": "https://raw.githubusercontent.com/ltzyl/zotero-paper-companion/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.*"
    }
  }
}